{
  "$schema": "http://json.schemastore.org/template",
  "author": "porkolabgergo",
  "classifications": ["Web", "API", "CQRS", "Vertical Slices"],
  "identity": "Apitemplate.CSharp",
  "name": "ASP.NET Core Web API (CQRS Vertical Slices)",
  "shortName": "apitpl",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Apitemplate",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "RootNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_name",
      "replaces": "Apitemplate",
      "fileRename": "Apitemplate"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            "bin/**",
            "obj/**",
            "*.user",
            "*.suo"
          ]
        }
      ]
    }
  ]
}
